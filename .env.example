# Copy to .env for docker-compose.dev.yml. The DB settings live in the compose file.

# Required: logic/apiCall.py builds both LLM clients at import and crashes if either key
# is missing. Any placeholder string lets the app boot; task parsing needs real keys.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Host ports (defaults 5000 / 5432)
# APP_PORT=5000
# DB_PORT=5432

# Optional: leave blank to disable these in dev
FLASK_SECRET_KEY=
DISCORD_WEBHOOK_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

TASKER_SMTP_USER=
TASKER_SMTP_PASS=
TASKER_FROM_ADDR=
TASKER_ADMIN_EMAIL=
TASKER_LOGIN_URL=http://localhost:5000/login
TASKER_README_URL=https://github.com/ani-pur/NLP_Tasker
